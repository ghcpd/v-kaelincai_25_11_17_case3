    {
      "id": "weak-network",
      "label": "Weak network retry",
      "classification": "error-handling",
      "initialState": {
        "installationName": "Eclipse Atrium",
        "installationState": "NORMAL",
        "crowdStatus": "Busy",
        "queueLength": 9,
        "nextProgram": "Message Burst @ 20:00",
        "networkCondition": "3G fallback (400ms)",
        "programs": [
          { "name": "Message Burst", "time": "20:00", "themes": ["Echo Pulse", "Glacier Drift"] }
        ],
        "messages": [
          "Sky: Delay felt but still here.",
          "Aria: Tried to vote twice."
        ]
      },
      "networkBehavior": {
        "vote": { "latency": 1500, "outcome": "success", "result": "vote accepted" },
        "message": { "latency": 1800, "outcome": "failure", "message": "Message timed out, retry" }
      },
      "steps": [
        "Vote with stale network",
        "Try sending message, observe failure",
        "Retry message for success"
      ],
      "expected": [
        "Vote eventually resolves despite latency",
        "Live wall shows retry message",
        "Retry button or guidance appears"
      ]
    },
    {
      "id": "maintenance",
      "label": "Maintenance mode",
      "classification": "error-handling",
      "initialState": {
        "installationName": "Riverside Prism",
        "installationState": "MAINTENANCE",
        "crowdStatus": "Closed",
        "queueLength": 0,
        "nextProgram": "Maintenance until 21:30",
        "networkCondition": "Offline",
        "programs": [],
        "messages": [
          "System: Installation under maintenance.",
          "Notice: Actions are disabled until further notice."
        ],
        "actionHint": "The installation is in maintenance. Please check back later."
      },
      "networkBehavior": {
        "vote": { "latency": 1000, "outcome": "failure", "message": "Actions disabled during maintenance" },
        "message": { "latency": 1000, "outcome": "failure", "message": "Cannot post while maintenance is active" }
      },
      "steps": [
        "Load maintenance state",
        "Attempt to vote or send message",
        "Observe guidance that actions are disabled"
      ],
      "expected": [
        "Both controls are disabled",
        "Status indicates MAINTENANCE",
        "Feedback explains why actions are unavailable"
      ]
    },
    {
