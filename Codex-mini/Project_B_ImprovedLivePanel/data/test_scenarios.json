{
  "scenarios": [
    {
      "id": "normal-flow",
      "label": "Standard program interaction",
      "classification": "normal",
      "initialState": {
        "installationName": "Pulse Light Plaza",
        "installationState": "NORMAL",
        "crowdStatus": "Calm",
        "queueLength": 4,
        "nextProgram": "Aurora Vote @ 18:30",
        "networkCondition": "Strong 5G (80ms)",
        "programs": [
          { "name": "Aurora Vote", "time": "18:30", "themes": ["City Bloom", "Neon Tides", "Urban Pulse"] },
          { "name": "Ambient Stories", "time": "19:15", "themes": ["Silent Waves", "Radiant Glimmer"] }
        ],
        "messages": [
          "Lena: Picked City Bloom!",
          "Marcus: Lights are soothing tonight.",
          "Visitor: Can't wait for the vote to close!"
        ]
      },
      "networkBehavior": {
        "vote": { "latency": 600, "outcome": "success", "result": "vote recorded" },
        "message": { "latency": 500, "outcome": "success", "result": "message posted" }
      },
      "steps": [
        "Load scenario",
        "Vote on the first theme",
        "Post a friendly message to the live wall"
      ],
      "expected": [
        "Status shows NORMAL and queue of 4",
        "Program list shows Aurora Vote and Ambient Stories",
        "Live wall appends user's message"
      ]
    },
    {
