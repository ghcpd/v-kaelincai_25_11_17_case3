        {
          "step": 6,
          "action": "observe",
          "target": "message_input",
          "description": "Message input field visible"
        },
        {
          "step": 7,
          "action": "click",
          "target": "tab_reservation_queue",
          "description": "Click Reservation Queue tab"
        },
        {
          "step": 8,
          "action": "observe",
          "target": "queue_list",
          "description": "Queue list displays with positions and user info"
        },
        {
          "step": 9,
          "action": "click",
          "target": "tab_program_interaction",
          "description": "Click back to Program Interaction tab"
        },
        {
          "step": 10,
          "action": "observe",
          "target": "program_section",
          "description": "Program section still visible with previous state preserved"
        }
      ],
      "expected_outcomes": {
        "visible_components": ["tab_navigation", "program_section", "message_feed", "queue_list"],
        "tab_switching_instant": true,
        "active_tab_visually_indicated": true,
        "content_matches_active_tab": true,
        "tab_state_preserved": true,
        "no_layout_shift": true,
        "accessibility": {
          "tab_roles_correct": true,
          "tabpanel_roles_correct": true,
          "keyboard_tab_navigation": true,
          "aria_selected_attribute": true
        }
      }
