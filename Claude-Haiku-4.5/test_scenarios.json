        {
          "step": 8,
          "action": "set_viewport",
          "width": 1920,
          "height": 1080,
          "description": "Set desktop viewport"
        },
        {
          "step": 9,
          "action": "observe",
          "target": "layout",
          "description": "Desktop layout uses whitespace and multi-column layout appropriately"
        }
