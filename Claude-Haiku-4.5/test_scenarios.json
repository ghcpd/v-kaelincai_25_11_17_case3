        },
        {
          "step": 6,
          "action": "press_key",
          "key": "Tab",
          "description": "Tab to first interactive control in tab panel"
        },
        {
          "step": 7,
          "action": "press_key",
          "key": "Enter",
          "description": "Press Enter on vote button"
        },
        {
          "step": 8,
          "action": "observe",
          "target": "success_announcement",
          "description": "Screen reader announces vote success"
        }
