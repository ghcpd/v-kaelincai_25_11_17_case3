    {
      "id": 6,
      "name": "Tabbed Navigation - Switching Between Sections",
      "category": "normal",
      "description": "User navigates between Program Interaction, Live Wall (Danmaku), and Reservation Queue tabs; each tab maintains visual state and shows correct content",
      "mock_state": {
        "installation_state": "NORMAL",
        "crowdedness": "MEDIUM",
        "queue_length": 8,
        "network_latency": 100,
        "network_failure_rate": 0,
        "programs": [
          {
            "id": "prog_001",
            "name": "Northern Lights Theme",
            "available_now": true,
            "status": "OPEN",
            "options": [
              { "id": "opt_1", "label": "Blue Aurora", "votes": 45 },
              { "id": "opt_2", "label": "Green Aurora", "votes": 38 }
            ]
          }
        ],
        "messages": [
          { "id": "msg_1", "author": "User_A", "text": "Amazing colors!", "timestamp": "2025-11-17T15:30:00Z" },
          { "id": "msg_2", "author": "User_C", "text": "Vote for blue!", "timestamp": "2025-11-17T15:31:00Z" }
        ],
        "queue_status": "QUEUED",
        "queue_entries": [
          { "position": 1, "user_id": "user_001", "reserved_duration_minutes": 5 },
          { "position": 2, "user_id": "user_002", "reserved_duration_minutes": 5 },
          { "position": 3, "user_id": "current_user", "reserved_duration_minutes": 5 }
        ]
      },
      "interactions": [
        {
          "step": 1,
          "action": "observe",
          "target": "tab_navigation",
          "description": "Three tabs visible: Program Interaction, Live Wall, Reservation Queue"
        },
        {
          "step": 2,
          "action": "click",
          "target": "tab_program_interaction",
          "description": "Click Program Interaction tab (default)"
        },
        {
          "step": 3,
          "action": "observe",
          "target": "program_section",
          "description": "Program voting interface displays"
        },
        {
          "step": 4,
          "action": "click",
          "target": "tab_live_wall",
          "description": "Click Live Wall (Danmaku) tab"
        },
        {
          "step": 5,
          "action": "observe",
          "target": "message_feed",
          "description": "Message feed with existing messages displays"
