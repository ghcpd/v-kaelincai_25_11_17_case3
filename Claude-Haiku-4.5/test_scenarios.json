        },
        {
          "step": 3,
          "action": "observe",
          "target": "buttons",
          "description": "Buttons have sufficient touch target size (min 44x44px)"
        },
        {
          "step": 4,
          "action": "observe",
          "target": "text",
          "description": "Text is readable without horizontal scrolling"
        },
        {
          "step": 5,
          "action": "click",
