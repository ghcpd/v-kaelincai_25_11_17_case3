            ]
          }
        ],
        "messages": [
          { "id": "msg_1", "author": "User_A", "text": "Cool!", "timestamp": "2025-11-17T15:30:00Z" }
        ],
        "queue_status": "EMPTY"
      },
      "interactions": [
        {
          "step": 1,
          "action": "observe",
