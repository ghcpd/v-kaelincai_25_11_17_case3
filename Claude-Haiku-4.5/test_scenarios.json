{
  "test_scenarios": [
    {
      "id": 1,
      "name": "Normal Flow - Vote on Light Theme",
      "category": "normal",
      "description": "User on good network lands on panel, sees available program, selects program, votes on light theme successfully",
      "mock_state": {
        "installation_state": "NORMAL",
        "crowdedness": "LOW",
        "queue_length": 0,
        "network_latency": 50,
        "network_failure_rate": 0,
        "programs": [
          {
            "id": "prog_001",
            "name": "Northern Lights Theme",
            "available_now": true,
            "status": "OPEN",
            "options": [
              { "id": "opt_1", "label": "Blue Aurora", "votes": 45 },
              { "id": "opt_2", "label": "Green Aurora", "votes": 38 }
            ]
          }
        ],
        "messages": [],
        "queue_status": "EMPTY"
      },
      "interactions": [
        {
          "step": 1,
          "action": "observe",
          "target": "page",
          "description": "Page loads and displays status area"
        },
        {
          "step": 2,
          "action": "click",
          "target": "program_card_prog_001",
          "description": "Click on available program"
        },
        {
          "step": 3,
          "action": "click",
          "target": "vote_button_opt_1",
          "description": "Click vote button for Blue Aurora"
        },
        {
          "step": 4,
          "action": "observe",
          "target": "success_toast",
          "description": "Confirm success notification appears"
        }
      ],
      "expected_outcomes": {
        "visible_components": ["status_area", "program_section", "vote_options", "success_toast"],
        "vote_recorded": true,
        "vote_count_updated": true,
        "button_enabled": true,
        "page_stable": true,
        "accessibility": {
          "focus_visible": true,
          "keyboard_navigable": true,
          "contrast_ratio": "4.5:1"
        }
      }
    },
    {
      "id": 2,
      "name": "Weak Network - Message Submission with Retry",
      "category": "edge",
      "description": "High latency and 30% request failure; user sends live message, sees loading, encounters transient failure, retries, succeeds",
      "mock_state": {
        "installation_state": "NORMAL",
        "crowdedness": "MEDIUM",
        "queue_length": 5,
        "network_latency": 2500,
        "network_failure_rate": 0.3,
        "programs": [
          {
            "id": "prog_001",
            "name": "Northern Lights Theme",
            "available_now": true,
            "status": "OPEN"
          }
        ],
        "messages": [
          { "id": "msg_1", "author": "User_A", "text": "So cool!", "timestamp": "2025-11-17T15:30:00Z" }
        ],
        "queue_status": "QUEUED"
      },
      "interactions": [
        {
          "step": 1,
          "action": "observe",
          "target": "live_wall_section",
          "description": "Navigate to Live Wall (Danmaku) section"
        },
        {
          "step": 2,
          "action": "click",
          "target": "message_input",
          "description": "Click on message input field"
        },
        {
          "step": 3,
          "action": "type",
          "target": "message_input",
          "text": "This is amazing!",
          "description": "Type a message"
        },
        {
          "step": 4,
          "action": "click",
          "target": "send_button",
          "description": "Click send button"
        },
        {
          "step": 5,
          "action": "observe",
          "target": "loading_indicator",
          "description": "Observe loading spinner appears"
        },
        {
          "step": 6,
          "action": "wait",
          "duration_ms": 3000,
          "description": "Wait for timeout / failure"
        },
        {
          "step": 7,
          "action": "observe",
          "target": "retry_button",
          "description": "Error message with retry button appears"
        },
        {
          "step": 8,
          "action": "click",
          "target": "retry_button",
          "description": "Click retry button"
        },
        {
          "step": 9,
          "action": "observe",
          "target": "loading_indicator",
          "description": "Loading spinner reappears briefly"
        },
        {
          "step": 10,
          "action": "observe",
          "target": "success_toast",
          "description": "Message sent successfully"
        }
      ],
      "expected_outcomes": {
        "visible_components": ["live_wall_section", "message_input", "loading_indicator", "retry_button", "success_toast"],
        "loading_shown": true,
        "retry_available": true,
        "message_eventually_sent": true,
        "user_can_interact_during_loading": false,
        "send_button_disabled_during_request": true,
        "input_cleared_on_success": true,
        "accessibility": {
          "aria_busy_attribute": true,
          "error_announced": true
        }
      }
    },
    {
      "id": 3,
      "name": "State Restrictions - Installation in PAUSED State",
      "category": "edge",
      "description": "Installation is PAUSED; all interaction buttons disabled with clear explanation; user cannot vote, message, or reserve",
      "mock_state": {
        "installation_state": "PAUSED",
        "crowdedness": "MEDIUM",
        "queue_length": 0,
        "network_latency": 50,
        "network_failure_rate": 0,
        "programs": [
          {
            "id": "prog_001",
            "name": "Northern Lights Theme",
            "available_now": true,
            "status": "CLOSED"
          }
        ],
        "messages": [],
        "queue_status": "CLOSED",
        "pause_reason": "System maintenance in progress. We'll be back online soon!"
      },
      "interactions": [
        {
          "step": 1,
          "action": "observe",
          "target": "page",
          "description": "Page loads showing PAUSED state"
        },
        {
          "step": 2,
          "action": "observe",
          "target": "status_message",
          "description": "System status shows pause reason message"
        },
        {
          "step": 3,
          "action": "observe",
          "target": "program_section",
          "description": "Program cards visible but marked as unavailable"
        },
        {
          "step": 4,
          "action": "try_click",
          "target": "vote_button",
          "description": "Attempt to click vote button (should be disabled)"
        }
      ],
      "expected_outcomes": {
        "visible_components": ["status_area", "pause_message", "program_section", "disabled_buttons"],
        "vote_button_disabled": true,
        "message_input_disabled": true,
        "reserve_button_disabled": true,
        "pause_reason_visible": true,
        "visual_distinction": "buttons appear grayed out, status area highlighted",
        "accessibility": {
          "disabled_buttons_announced": true,
          "aria_disabled_attribute": true,
          "reason_text_accessible": true
        }
      }
    },
    {
      "id": 4,
      "name": "Crowded Installation State - Queue Warning",
      "category": "edge",
      "description": "Installation CROWDED with 50+ in queue; UI surfaces warning about wait times but interactions still allowed with queue info",
      "mock_state": {
        "installation_state": "CROWDED",
        "crowdedness": "HIGH",
        "queue_length": 52,
        "network_latency": 150,
        "network_failure_rate": 0.1,
        "programs": [
          {
            "id": "prog_001",
            "name": "Northern Lights Theme",
            "available_now": true,
            "status": "OPEN",
            "estimated_wait_minutes": 15
          }
        ],
        "messages": [
          { "id": "msg_1", "author": "User_B", "text": "Long wait!", "timestamp": "2025-11-17T15:35:00Z" }
        ],
        "queue_status": "LONG_QUEUE"
      },
      "interactions": [
        {
          "step": 1,
          "action": "observe",
          "target": "status_area",
          "description": "Status area shows crowdedness warning"
        },
        {
          "step": 2,
          "action": "observe",
          "target": "queue_info_widget",
          "description": "Queue length and wait time prominently displayed"
        },
        {
          "step": 3,
          "action": "click",
          "target": "program_card_prog_001",
          "description": "Click on program (allowed despite crowding)"
        },
        {
          "step": 4,
          "action": "observe",
          "target": "queue_warning",
          "description": "Warning about wait time shown near vote button"
        },
        {
          "step": 5,
          "action": "click",
          "target": "reserve_slot_button",
          "description": "Click reserve button"
        }
      ],
      "expected_outcomes": {
        "visible_components": ["status_area", "crowdedness_warning", "queue_info_widget", "program_section", "reserve_button"],
        "crowdedness_visually_distinguished": true,
        "queue_length_visible": true,
        "estimated_wait_visible": true,
        "buttons_enabled": true,
        "reserve_shows_queue_position": true,
        "accessibility": {
          "warning_announced": true,
          "queue_info_readable": true
        }
      }
    },
    {
