          "description": "Vote button is clickable on mobile"
        },
        {
          "step": 6,
          "action": "set_viewport",
          "width": 768,
          "height": 1024,
          "description": "Set tablet viewport (iPad)"
        },
        {
          "step": 7,
          "action": "observe",
