    "steps":["open:Programs","click:Vote","expect:toast:Vote recorded"],
    "expected":["status:NORMAL","queue:0","message:Vote recorded"]
  },
  {
    "id":"weak-network",
    "classification":"error-handling",
    "description":"Simulated high latency and transient failure; user tries send message with retry.",
    "initial":{"state":"NORMAL","programs":[],"queue":1,"network":"slow+failures"},
    "steps":["open:Live Wall","type:Hello","click:Send","expect:loading","expect:retry","click:Retry","expect:success"],
    "expected":["message:Hello","status:NORMAL"]
  },
  {
    "id":"paused-state",
    "classification":"edge",
    "description":"Installation is PAUSED; interactions disabled.",
    "initial":{"state":"PAUSED","programs":[{"id":"p2","title":"Sound Garden","available":false}],"queue":5},
    "steps":["open:Programs","expect:buttons:disabled","expect:explain:Paused"],
    "expected":["state:PAUSED","buttons:disabled"]
  },
  {
    "id":"crowded-state",
    "classification":"edge",
    "description":"High queue length; show warning and wait times.",
    "initial":{"state":"CROWDED","queue":25,"programs":[{"id":"p3","title":"Light Show","available":true}]},
    "steps":["open:Status","expect:warning","open:Programs","expect:available:partial"],
    "expected":["state:CROWDED","queue:25"]
  },
  {
    "id":"empty-state",
    "classification":"edge",
    "description":"No upcoming programs; show empty state with call-to-action.",
    "initial":{"state":"NORMAL","programs":[],"queue":0},
    "steps":["open:Programs","expect:empty:Explore other installations"],
    "expected":["programs:empty"]
  }
